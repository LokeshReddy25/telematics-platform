# Python bytecode caches
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Test/lint tool caches
.pytest_cache/
.flake8_cache/

# Trained model artifact -- regenerated by `python ml/train_model.py`
# (also regenerated fresh in CI), so it doesn't belong in version control.
ml/models/*.pkl

# Terraform: keep the .tf source and the lock file (both should be
# versioned so provider versions stay reproducible), but never commit the
# downloaded provider binaries, any real state file, saved plan output, or
# crash logs. *.tfvars is excluded because that's where real values (your
# public IP, real vpc_id/subnet_ids, db_password) actually live -- never
# committed, only passed locally or via TF_VAR_ environment variables.
devops/terraform/.terraform/
devops/terraform/*.tfstate
devops/terraform/*.tfstate.*
devops/terraform/*.tfvars
devops/terraform/*.tfplan
devops/terraform/crash.log

# Same protection for every Terraform directory (e.g. devops/terraform-ec2/):
# provider binaries, state (contains account IDs, IPs, resource IDs), saved
# plans, variable files and crash logs are never committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
**/crash.log

# Key material must never be committed.
*.pem
*.key
*.ppk

# Ad-hoc logs generated while running/debugging the stack locally
*.log

# Benchmark evidence: raw logs under results/ ARE committed (they back every
# number in results/results.md), overriding the *.log rule above.
!results/**/*.log

# Coverage output
.coverage
coverage.xml
htmlcov/
