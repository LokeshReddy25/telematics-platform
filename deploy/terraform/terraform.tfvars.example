# terraform.tfvars.example -- copy to terraform.tfvars and fill in the
# secrets. terraform.tfvars is gitignored: never commit real values.
#
#   cp terraform.tfvars.example terraform.tfvars
#   # edit terraform.tfvars, then:
#   terraform init && terraform apply
#
# Alternatively, skip this file entirely and pass the secrets as
# environment variables instead:
#   export TF_VAR_db_password='...'
#   export TF_VAR_jwt_secret="$(openssl rand -hex 32)"

aws_region  = "ap-south-1"
environment = "dev"

# Master password for the API's RDS PostgreSQL database (min 8 chars;
# avoid / " @ and spaces). This is also embedded in the DATABASE_URL
# secret, so the API never needs it directly.
db_password = "CHANGE-ME-to-a-strong-password"

# Secret key the API uses to sign JWTs (min 16 chars). Generate one with:
#   openssl rand -hex 32
jwt_secret = "CHANGE-ME-to-a-long-random-string"
