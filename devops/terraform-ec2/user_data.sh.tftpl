#!/bin/bash
# user_data for the telematics single-EC2 demo (rendered by Terraform).
# Installs Docker, the Compose and Buildx plugins and git, adds swap, clones the
# repo, and writes docker-compose.aws.yml next to it. It does NOT start the stack.
set -euxo pipefail
exec > >(tee -a /var/log/telematics-bootstrap.log) 2>&1

# 1. Safety net first: shut down (= terminate, see instance_initiated_shutdown_behavior)
#    after the time limit, even if anything below fails.
shutdown -h +${auto_terminate_minutes} "telematics-demo: auto-terminate after ${auto_terminate_minutes} minutes"

# 2. Swap
if [ ! -f /swapfile ]; then
  fallocate -l ${swap_gb}G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

# 3. Docker + git from the Amazon Linux 2023 repositories
dnf install -y docker git
systemctl enable --now docker

# 4. Compose and Buildx CLI plugins, pinned and checked against the
#    SHA-256 values published with each GitHub release.
PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$PLUGINS"
curl -fsSL -o "$PLUGINS/docker-compose" \
  https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64
echo "383ce6698cd5d5bbf958d2c8489ed75094e34a77d340404d9f32c4ae9e12baf0  $PLUGINS/docker-compose" | sha256sum -c -
curl -fsSL -o "$PLUGINS/docker-buildx" \
  https://github.com/docker/buildx/releases/download/v0.17.1/buildx-v0.17.1.linux-amd64
echo "aa7a9778349e1a8ace685e4c51a1d33e7a9b0aa6925d1c625b09cb3800eba696  $PLUGINS/docker-buildx" | sha256sum -c -
chmod 755 "$PLUGINS/docker-compose" "$PLUGINS/docker-buildx"
docker compose version
docker buildx version

# 5. Clone the repo (stack is NOT started here)
git clone --branch ${repo_branch} --depth 1 ${repo_url} /opt/telematics-platform
echo '${compose_override_b64}' | base64 -d > /opt/telematics-platform/docker-compose.aws.yml

echo "bootstrap complete $(date -Is)" > /var/lib/telematics-bootstrap.done
